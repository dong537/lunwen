# 复制为 .env 后填写。不要提交 .env 或真实密钥。
POSTGRES_PASSWORD=
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=
COS_BUCKET=
COS_REGION=
# 可选。留空走公网 cos.<region>.myqcloud.com；
# 服务器与桶同地域时填 cos-internal.<region>.myqcloud.com 走内网。
# 只填域名后缀，不含协议、桶名和路径。
COS_ENDPOINT=
# 可选。浏览器直传/直下使用的公网域名后缀，例如 cos.ap-beijing.myqcloud.com。
# 留空使用 SDK 默认公网 endpoint；不能填内网域名、协议、桶名或路径。
COS_PUBLIC_ENDPOINT=
COS_SECRET_ID=
COS_SECRET_KEY=
# 浏览器直传有效期（秒），同时约束上传 URL 和下载 URL。
PRESIGN_EXPIRE_SECONDS=600
# proxy：保留旧的服务器中转上传/下载；direct：浏览器直传 COS 和从 COS 下载。
TRANSFER_MODE=proxy
PLATFORM_HTTP_PORT=8080
# HTTPS生产环境设为true；HTTP本地测试为false。
SESSION_COOKIE_SECURE=false
