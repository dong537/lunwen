# 复制为 .env 后填写。不要提交 .env 或真实密钥。
POSTGRES_PASSWORD=
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=

COS_BUCKET=
COS_REGION=ap-shanghai
# 服务器与桶同地域时填 cos-internal.ap-shanghai.myqcloud.com 走内网；
# 本地开发、跨地域或不确定时留空，走公网 cos.ap-shanghai.myqcloud.com。
# 只填域名后缀，不含协议、桶名和路径。
COS_ENDPOINT=
# 浏览器直传/直下使用的公网域名后缀，例如 cos.ap-shanghai.myqcloud.com。
# 留空使用 SDK 默认公网 endpoint；不能填内网域名、协议、桶名或路径。
COS_PUBLIC_ENDPOINT=cos.ap-shanghai.myqcloud.com
COS_SECRET_ID=
COS_SECRET_KEY=

# 浏览器直传/直下 URL 有效期（秒），同时约束上传和下载 URL。
PRESIGN_EXPIRE_SECONDS=600

# direct：浏览器直传 COS 和从 COS 下载；proxy：旧的服务器中转，故障时回退。
TRANSFER_MODE=direct

# 生产使用 18090；本地 HTTP 调试可改为 8080。
PLATFORM_HTTP_PORT=18090
# 生产 HTTPS 保持 true；本地 HTTP 调试改为 false。
SESSION_COOKIE_SECURE=true
